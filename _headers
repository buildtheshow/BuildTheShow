# Cloudflare Pages — cache headers
# Reuse shared assets between pages. Version query strings are bumped when shared
# code changes, while HTML always revalidates below so page edits stay visible.
/ASSETS/styles/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/ASSETS/scripts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/ASSETS/Images/*
  Cache-Control: public, max-age=31536000, immutable

/SHARED/Components/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/SHARED/Navigation/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# HTML pages: always revalidate so updates deploy instantly
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/SYSTEM/*
  Cache-Control: public, max-age=0, must-revalidate

/PUBLIC/*
  Cache-Control: public, max-age=0, must-revalidate
