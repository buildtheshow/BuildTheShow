# Canonical public/member/organisation routes are served in functions/_middleware.js.
# The rules below retain older specialised aliases.
# ── Public standalone pages (served as directories — no rewrite rules needed) ──
# /volunteer-quiz → volunteer-quiz/index.html  (native directory serve)
# /volunteers     → volunteers/index.html       (native directory serve)
/PUBLIC/volunteer-quiz /volunteer-quiz                             301

